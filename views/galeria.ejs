<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galería - CuidAnimals</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo-brand">
                <span class="logo-icon">🐾</span>
                <span class="logo-text">CuidAnimals</span>
            </div>
            <ul class="nav-links">
                <li><a href="/">Inicio</a></li>
                <li><a href="/servicios">Servicios</a></li>
                <li><a href="/sobre-nosotros">Sobre Nosotros</a></li>
                <li><a href="/galeria" class="active">Galería</a></li>
                <li><a href="/citas">Citas</a></li>
                <li><a href="/contacto">Contacto</a></li>
            </ul>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1>Galería de Mascotas</h1>
            <p>Mira a las mascotas felices en CuidAnimals</p>
        </div>
    </section>

    <!-- Galería -->
    <section class="gallery-section">
        <div class="container">
            <div class="gallery-grid">
                <!-- Fotos reales de CuidAnimals -->
                <div class="gallery-item">
                    <img src="/images/foto1.jpg" alt="Cuidado amoroso de mascotas" class="gallery-image">
                    <p>Cuidado Amoroso</p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐕</div>
                    <p>Perros Felices</p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐈</div>
                    <p>Gatos Cómodos</p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐰</div>
                    <p>Conejitos en Guardería</p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐾</div>
                    <p>Tiempo de Juego</p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐕‍🦺</div>
                    <p>Paseos al Aire Libre</p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">😺</div>
                    <p>Momentos Especiales</p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐕</div>
                    <p>Sociabilización</p>
                </div>
            </div>
            <div class="gallery-note">
                <p>📸 Comparte tus fotos con nosotros en Instagram: @cuidanimals.esp</p>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
        <div class="container">
            <h2>¿Quieres ver a tu mascota feliz?</h2>
            <p>Reserva tu primera cita y únete a nuestra comunidad de mascotas felices</p>
            <a href="/citas" class="btn btn-primary">Reservar Ahora</a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 CuidAnimals. Todos los derechos reservados.</p>
            <div class="social-links">
                <a href="https://instagram.com/cuidanimals.esp" target="_blank">Instagram</a>
                <a href="https://facebook.com/cuidanimals" target="_blank">Facebook</a>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/34622358009?text=Hola%20CuidAnimals%20quiero%20saber%20más%20sobre%20vuestros%20servicios" target="_blank" class="whatsapp-button" title="Contactar por WhatsApp">
        <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.75 21 3 13.25 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
        </svg>
    </a>

    <script src="/script.js"></script>
</body>
</html>
