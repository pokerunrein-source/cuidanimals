<%
  const pageTitle = t.galeria.title;
  const pageDescription = 'Galería de mascotas felices en CuidAnimals. Mira a los perros, gatos y otros animales disfrutando de nuestros servicios de cuidado profesional.';
  const pageUrl = '/galeria';
%>
<%- include('header', { pageTitle, pageDescription, pageUrl, t }) %>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo-brand">
                <span class="logo-icon">🐾</span>
                <span class="logo-text">CuidAnimals</span>
            </div>
            <ul class="nav-links">
                <li><a href="/"><%= t.nav.inicio %></a></li>
                <li><a href="/servicios"><%= t.nav.servicios %></a></li>
                <li><a href="/sobre-nosotros"><%= t.nav.sobre_nosotros %></a></li>
                <li><a href="/galeria" class="active"><%= t.nav.galeria %></a></li>
                <li><a href="/citas"><%= t.nav.citas %></a></li>
                <li><a href="/contacto"><%= t.nav.contacto %></a></li>
            </ul>
            <div class="lang-switcher">
                <a href="/set-lang/es" class="lang-btn <%= t.lang === 'es' ? 'active' : '' %>">ES</a>
                <a href="/set-lang/en" class="lang-btn <%= t.lang === 'en' ? 'active' : '' %>">EN</a>
                <a href="/set-lang/fr" class="lang-btn <%= t.lang === 'fr' ? 'active' : '' %>">FR</a>
                <a href="/set-lang/de" class="lang-btn <%= t.lang === 'de' ? 'active' : '' %>">DE</a>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1><%= t.galeria.page_title %></h1>
            <p><%= t.galeria.page_subtitle %></p>
        </div>
    </section>

    <!-- Galería -->
    <section class="gallery-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-dog" style="top: 10%; left: 8%;">🐾</div>
            <div class="paw-print paw-cat" style="top: 25%; right: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 20%; left: 12%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 10%; right: 8%;">🐾</div>
        </div>
        <div class="container">
            <div class="gallery-grid">
                <div class="gallery-item">
                    <img src="/images/foto1.jpg" alt="<%= t.galeria.foto1 %>" class="gallery-image">
                    <p><%= t.galeria.foto1 %></p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐕</div>
                    <p><%= t.galeria.foto2 %></p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐈</div>
                    <p><%= t.galeria.foto3 %></p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐰</div>
                    <p><%= t.galeria.foto4 %></p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐾</div>
                    <p><%= t.galeria.foto5 %></p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐕‍🦺</div>
                    <p><%= t.galeria.foto6 %></p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">😺</div>
                    <p><%= t.galeria.foto7 %></p>
                </div>
                <div class="gallery-item">
                    <div class="gallery-placeholder">🐕</div>
                    <p><%= t.galeria.foto8 %></p>
                </div>
            </div>
            <div class="gallery-note">
                <p><%= t.galeria.instagram_note %></p>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-cat" style="top: 10%; left: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="top: 15%; right: 12%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 15%; right: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 5%; left: 8%;">🐾</div>
        </div>
        <div class="container">
            <h2><%= t.galeria.cta_title %></h2>
            <p><%= t.galeria.cta_subtitle %></p>
            <a href="/citas" class="btn btn-primary"><%= t.galeria.cta_btn %></a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p><%= t.footer.rights %></p>
            <div class="social-links">
                <a href="https://instagram.com/cuidanimals.esp" target="_blank"><img src="/images/Instagram_icon.png" alt="Instagram" class="social-icon"> Instagram</a>
                <a href="https://facebook.com/cuidanimals" target="_blank"><img src="/images/facebook_logo_icon_257007.webp" alt="Facebook" class="social-icon"> Facebook</a>
                <a href="https://tiktok.com/@cuidanimals" target="_blank" class="tiktok-link">
                    <svg class="social-icon tiktok-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
                        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9.12a8.16 8.16 0 0 0 4.77 1.52V7.19a4.85 4.85 0 0 1-1-.5z"/>
                    </svg>
                    TikTok
                </a>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/34622358009?text=<%= t.whatsapp.message %>" target="_blank" class="whatsapp-button" title="<%= t.whatsapp.title %>">
        <img src="/images/whatsapp-logo.webp" alt="WhatsApp" class="whatsapp-logo-img">
    </a>

    <script src="/script.js"></script>
</body>
</html>
