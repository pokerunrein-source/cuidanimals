<%
  const pageTitle = t.servicios.title;
  const pageDescription = 'Descubre nuestros servicios de cuidado de mascotas: visitas a domicilio, guardería familiar y paseos de perros en Pego, Alicante.';
  const pageUrl = '/servicios';
%>
<%- include('header', { pageTitle, pageDescription, pageUrl, t }) %>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo-brand">
                <span class="logo-icon">🐾</span>
                <span class="logo-text">CuidAnimals</span>
            </div>
            <ul class="nav-links">
                <li><a href="/"><%= t.nav.inicio %></a></li>
                <li><a href="/servicios" class="active"><%= t.nav.servicios %></a></li>
                <li><a href="/sobre-nosotros"><%= t.nav.sobre_nosotros %></a></li>
                <li><a href="/galeria"><%= t.nav.galeria %></a></li>
                <li><a href="/citas"><%= t.nav.citas %></a></li>
                <li><a href="/contacto"><%= t.nav.contacto %></a></li>
            </ul>
            <div class="lang-switcher">
                <a href="/set-lang/es" class="lang-btn <%= t.lang === 'es' ? 'active' : '' %>">ES</a>
                <a href="/set-lang/en" class="lang-btn <%= t.lang === 'en' ? 'active' : '' %>">EN</a>
                <a href="/set-lang/fr" class="lang-btn <%= t.lang === 'fr' ? 'active' : '' %>">FR</a>
                <a href="/set-lang/de" class="lang-btn <%= t.lang === 'de' ? 'active' : '' %>">DE</a>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1><%= t.servicios.page_title %></h1>
            <p><%= t.servicios.page_subtitle %></p>
            <p class="page-header-description"><%= t.servicios.page_description %></p>
        </div>
    </section>

    <!-- Servicios Detallados -->
    <section class="servicios-detail" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-dog" style="top: 10%; left: 8%;">🐾</div>
            <div class="paw-print paw-cat" style="top: 20%; right: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 20%; left: 12%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 10%; right: 8%;">🐾</div>
        </div>
        <div class="container">
            <% servicios.forEach(servicio => { %>
                <div class="servicio-detail-card">
                    <div class="servicio-detail-icon"><%= servicio.icono %></div>
                    <div class="servicio-detail-content">
                        <h2><%= servicio.nombre %></h2>
                        <p><%= servicio.descripcion_detalle || servicio.descripcion %></p>
                        <p class="precio"><strong><%= t.servicios.precio_label %> <%= servicio.precio %></strong></p>
                        <ul class="features">
                            <% if (servicio.features && servicio.features.length) { %>
                                <% servicio.features.forEach(feature => { %>
                                    <li><%= feature %></li>
                                <% }); %>
                            <% } %>
                        </ul>
                        <a href="/citas" class="btn btn-primary"><%= t.servicios.reservar_prefix %> <%= servicio.nombre %></a>
                    </div>
                </div>
            <% }); %>
        </div>
    </section>

    <!-- Por qué elegirnos -->
    <section class="why-us" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-cat" style="top: 10%; left: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="top: 25%; right: 12%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 15%; right: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 5%; left: 8%;">🐾</div>
        </div>
        <div class="container">
            <h2><%= t.servicios.por_que_title %></h2>
            <div class="why-us-grid">
                <div class="why-card">
                    <h3><%= t.servicios.why1_title %></h3>
                    <p><%= t.servicios.why1_desc %></p>
                </div>
                <div class="why-card">
                    <h3><%= t.servicios.why2_title %></h3>
                    <p><%= t.servicios.why2_desc %></p>
                </div>
                <div class="why-card">
                    <h3><%= t.servicios.why3_title %></h3>
                    <p><%= t.servicios.why3_desc %></p>
                </div>
                <div class="why-card">
                    <h3><%= t.servicios.why4_title %></h3>
                    <p><%= t.servicios.why4_desc %></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p><%= t.footer.rights %></p>
            <div class="social-links">
                <a href="https://instagram.com/cuidanimals.esp" target="_blank"><img src="/images/Instagram_icon.png" alt="Instagram" class="social-icon"> Instagram</a>
                <a href="https://facebook.com/cuidanimals" target="_blank"><img src="/images/facebook_logo_icon_257007.webp" alt="Facebook" class="social-icon"> Facebook</a>
                <a href="https://tiktok.com/@cuidanimals" target="_blank" class="tiktok-link">
                    <svg class="social-icon tiktok-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
                        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9.12a8.16 8.16 0 0 0 4.77 1.52V7.19a4.85 4.85 0 0 1-1-.5z"/>
                    </svg>
                    TikTok
                </a>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/34622358009?text=<%= t.whatsapp.message %>" target="_blank" class="whatsapp-button" title="<%= t.whatsapp.title %>">
        <img src="/images/whatsapp-logo.webp" alt="WhatsApp" class="whatsapp-logo-img">
    </a>

    <script src="/script.js"></script>
</body>
</html>
