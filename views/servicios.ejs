<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Servicios - CuidAnimals</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo-brand">
                <span class="logo-icon">🐾</span>
                <span class="logo-text">CuidAnimals</span>
            </div>
            <ul class="nav-links">
                <li><a href="/">Inicio</a></li>
                <li><a href="/servicios" class="active">Servicios</a></li>
                <li><a href="/sobre-nosotros">Sobre Nosotros</a></li>
                <li><a href="/galeria">Galería</a></li>
                <li><a href="/citas">Citas</a></li>
                <li><a href="/contacto">Contacto</a></li>
            </ul>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1>Nuestros Servicios</h1>
            <p>Ofertas profesionales de cuidado para tu mascota</p>
        </div>
    </section>

    <!-- Servicios Detallados -->
    <section class="servicios-detail">
        <div class="container">
            <% servicios.forEach(servicio => { %>
                <div class="servicio-detail-card">
                    <div class="servicio-detail-icon"><%= servicio.icono %></div>
                    <div class="servicio-detail-content">
                        <h2><%= servicio.nombre %></h2>
                        <p><%= servicio.descripcion %></p>
                        <p class="precio"><strong>Precio: <%= servicio.precio %></strong></p>
                        <ul class="features">
                            <li>✓ Servicio profesional</li>
                            <li>✓ Atención personalizada</li>
                            <li>✓ Máxima seguridad</li>
                            <li>✓ Disponible todos los días</li>
                        </ul>
                        <a href="/citas" class="btn btn-primary">Reservar <%= servicio.nombre %></a>
                    </div>
                </div>
            <% }); %>
        </div>
    </section>

    <!-- Por qué elegirnos -->
    <section class="why-us">
        <div class="container">
            <h2>¿Por qué elegir CuidAnimals?</h2>
            <div class="why-us-grid">
                <div class="why-card">
                    <h3>👥 Profesionales Certificados</h3>
                    <p>Nuestro equipo cuenta con experiencia y certificaciones en cuidado animal.</p>
                </div>
                <div class="why-card">
                    <h3>❤️ Amor por los Animales</h3>
                    <p>Cada mascota recibe atención amorosa y personalizada.</p>
                </div>
                <div class="why-card">
                    <h3>🔒 Seguridad Garantizada</h3>
                    <p>Cuidamos la seguridad y bienestar de tu mascota en todo momento.</p>
                </div>
                <div class="why-card">
                    <h3>📞 Disponibilidad 24/7</h3>
                    <p>Siempre disponibles para resolver cualquier emergencia.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 CuidAnimals. Todos los derechos reservados.</p>
            <div class="social-links">
                <a href="https://instagram.com/cuidanimals.esp" target="_blank">Instagram</a>
                <a href="https://facebook.com/cuidanimals" target="_blank">Facebook</a>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/34622358009?text=Hola%20CuidAnimals%20quiero%20saber%20más%20sobre%20vuestros%20servicios" target="_blank" class="whatsapp-button" title="Contactar por WhatsApp">
        <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.876 1.174l-.312.156-3.23-.849.86 3.126.207.311a9.758 9.758 0 001.426 4.302c1.521 2.31 4.175 3.727 7.01 3.727 1.9 0 3.697-.478 5.336-1.379l.312-.187 3.232.847-.861-3.127-.208-.31a9.758 9.758 0 00-1.426-4.303c-1.521-2.31-4.175-3.727-7.01-3.727m5.421 13.5c-1.956.5-3.989.5-6.03-.077-2.04-.577-3.906-1.65-5.38-3.106-1.475-1.456-2.576-3.296-3.153-5.35-.577-2.053-.577-4.234.077-6.303.654-2.069 1.792-4.029 3.365-5.603 1.573-1.575 3.596-2.729 5.697-3.383 2.1-.654 4.305-.654 6.404.077 2.1.73 4.03 1.93 5.54 3.485 1.51 1.555 2.66 3.44 3.308 5.486.649 2.046.649 4.235-.077 6.303-.726 2.068-1.93 4.017-3.543 5.556-1.612 1.539-3.656 2.663-5.932 3.292"/>
