<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contacto - CuidAnimals</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo-brand">
                <span class="logo-icon">🐾</span>
                <span class="logo-text">CuidAnimals</span>
            </div>
            <ul class="nav-links">
                <li><a href="/">Inicio</a></li>
                <li><a href="/servicios">Servicios</a></li>
                <li><a href="/sobre-nosotros">Sobre Nosotros</a></li>
                <li><a href="/galeria">Galería</a></li>
                <li><a href="/citas">Citas</a></li>
                <li><a href="/contacto" class="active">Contacto</a></li>
            </ul>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1>Contacto</h1>
            <p>¿Preguntas? Nos encantaría escucharte</p>
        </div>
    </section>

    <!-- Contacto Section -->
    <section class="contacto-section">
        <div class="container">
            <div class="contacto-wrapper">
                <!-- Formulario -->
                <div class="contacto-form">
                    <h2>Envíanos un Mensaje</h2>
                    <form id="contactForm">
                        <div class="form-group">
                            <label for="nombre">Nombre *</label>
                            <input type="text" id="nombre" name="nombre" required>
                        </div>

                        <div class="form-group">
                            <label for="email">Email *</label>
                            <input type="email" id="email" name="email" required>
                        </div>

                        <div class="form-group">
                            <label for="telefono">Teléfono</label>
                            <input type="tel" id="telefono" name="telefono">
                        </div>

                        <div class="form-group">
                            <label for="mensaje">Mensaje *</label>
                            <textarea id="mensaje" name="mensaje" rows="6" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary btn-large">Enviar Mensaje</button>
                        <div id="formMessage" class="form-message" style="display: none;"></div>
                    </form>
                </div>

                <!-- Información de contacto -->
                <div class="contacto-info">
                    <h2>Información de Contacto</h2>

                    <div class="info-item">
                        <h3>📍 Ubicación</h3>
                        <p><%= contactInfo.direccion %></p>
                    </div>

                    <div class="info-item">
                        <h3>📞 Teléfono</h3>
                        <p><a href="tel:<%= contactInfo.telefono %>"><%= contactInfo.telefono %></a></p>
                    </div>

                    <div class="info-item">
                        <h3>📧 Email</h3>
                        <p><a href="mailto:info@cuidanimals.es">info@cuidanimals.es</a></p>
                    </div>

                    <div class="info-item">
                        <h3>⏰ Horario</h3>
                        <p><strong>Lunes a Viernes:</strong> <%= contactInfo.horario.lunes_viernes %></p>
                        <p><strong>Sábados:</strong> <%= contactInfo.horario.sabados %></p>
                        <p><strong>Domingos:</strong> <%= contactInfo.horario.domingos %></p>
                    </div>

                    <div class="info-item">
                        <h3>🌐 Redes Sociales</h3>
                        <p>
                            <a href="https://instagram.com/cuidanimals.esp" target="_blank">Instagram</a> |
                            <a href="https://facebook.com/cuidanimals" target="_blank">Facebook</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Mapa -->
    <section class="map-section">
        <div class="container">
            <h2>Localización</h2>
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3118.3984568074926!2d-0.3987!3d38.7626!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd623f8b0f8b0f8b%3A0x1234567890123456!2sCarrer%20Sant%20Jaume%2C%2025%2C%2003780%20Pego%2C%20Alicante!5e0!3m2!1ses!2ses!4v1234567890123" width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 CuidAnimals. Todos los derechos reservados.</p>
            <div class="social-links">
                <a href="https://instagram.com/cuidanimals.esp" target="_blank">Instagram</a>
                <a href="https://facebook.com/cuidanimals" target="_blank">Facebook</a>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/34622358009?text=Hola%20CuidAnimals%20quiero%20saber%20más%20sobre%20vuestros%20servicios" target="_blank" class="whatsapp-button" title="Contactar por WhatsApp">
        <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
    </a>

    <script src="/script.js"></script>
    <script>
        document.getElementById('contactForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const formData = {
                nombre: document.getElementById('nombre').value,
                email: document.getElementById('email').value,
                telefono: document.getElementById('telefono').value,
                mensaje: document.getElementById('mensaje').value
            };

            try {
                const response = await fetch('/api/contacto', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (data.success) {
                    document.getElementById('formMessage').textContent = '✅ ' + data.mensaje;
                    document.getElementById('formMessage').classList.add('success');
                    document.getElementById('formMessage').style.display = 'block';
                    document.getElementById('contactForm').reset();
                }
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('formMessage').textContent = '❌ Error al enviar el mensaje. Intenta de nuevo.';
                document.getElementById('formMessage').classList.add('error');
                document.getElementById('formMessage').style.display = 'block';
            }
        });
    </script>
</body>
</html>
