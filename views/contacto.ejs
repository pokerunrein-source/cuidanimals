<%
  const pageTitle = t.contacto.title;
  const pageDescription = 'Contacta con CuidAnimals en Pego, Alicante. Disponibles 24/7 para responder tus preguntas sobre cuidado de mascotas.';
  const pageUrl = '/contacto';
%>
<%- include('header', { pageTitle, pageDescription, pageUrl, t }) %>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo-brand">
                <span class="logo-icon">🐾</span>
                <span class="logo-text">CuidAnimals</span>
            </div>
            <ul class="nav-links">
                <li><a href="/"><%= t.nav.inicio %></a></li>
                <li><a href="/servicios"><%= t.nav.servicios %></a></li>
                <li><a href="/sobre-nosotros"><%= t.nav.sobre_nosotros %></a></li>
                <li><a href="/galeria"><%= t.nav.galeria %></a></li>
                <li><a href="/citas"><%= t.nav.citas %></a></li>
                <li><a href="/contacto" class="active"><%= t.nav.contacto %></a></li>
            </ul>
            <div class="lang-switcher">
                <a href="/set-lang/es" class="lang-btn <%= t.lang === 'es' ? 'active' : '' %>">ES</a>
                <a href="/set-lang/en" class="lang-btn <%= t.lang === 'en' ? 'active' : '' %>">EN</a>
                <a href="/set-lang/fr" class="lang-btn <%= t.lang === 'fr' ? 'active' : '' %>">FR</a>
                <a href="/set-lang/de" class="lang-btn <%= t.lang === 'de' ? 'active' : '' %>">DE</a>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1><%= t.contacto.page_title %></h1>
            <p><%= t.contacto.page_subtitle %></p>
        </div>
    </section>

    <!-- Contacto Section -->
    <section class="contacto-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-dog" style="top: 10%; left: 10%;">🐾</div>
            <div class="paw-print paw-cat" style="top: 25%; right: 12%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 20%; right: 10%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 10%; left: 8%;">🐾</div>
        </div>
        <div class="container">
            <div class="contacto-wrapper">
                <!-- Formulario -->
                <div class="contacto-form">
                    <h2><%= t.contacto.form_title %></h2>
                    <form id="contactForm">
                        <div class="form-group">
                            <label for="nombre"><%= t.contacto.nombre_label %></label>
                            <input type="text" id="nombre" name="nombre" required>
                        </div>

                        <div class="form-group">
                            <label for="email"><%= t.contacto.email_label %></label>
                            <input type="email" id="email" name="email" required>
                        </div>

                        <div class="form-group">
                            <label for="telefono"><%= t.contacto.telefono_label %></label>
                            <input type="tel" id="telefono" name="telefono">
                        </div>

                        <div class="form-group">
                            <label for="mensaje"><%= t.contacto.mensaje_label %></label>
                            <textarea id="mensaje" name="mensaje" rows="6" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary btn-large"><%= t.contacto.submit_btn %></button>
                        <div id="formMessage" class="form-message" style="display: none;"></div>
                    </form>
                </div>

                <!-- Información de contacto -->
                <div class="contacto-info">
                    <h2><%= t.contacto.info_title %></h2>

                    <div class="info-item">
                        <h3><%= t.contacto.ubicacion_label %></h3>
                        <p><%= contactInfo.direccion %></p>
                    </div>

                    <div class="info-item">
                        <h3><%= t.contacto.telefono_section %></h3>
                        <p><a href="tel:<%= contactInfo.telefono %>"><%= contactInfo.telefono %></a></p>
                    </div>

                    <div class="info-item">
                        <h3><%= t.contacto.email_section %></h3>
                        <p><a href="mailto:info@cuidanimals.es">info@cuidanimals.es</a></p>
                    </div>

                    <div class="info-item">
                        <h3><%= t.contacto.horario_section %></h3>
                        <div class="horario-mini">
                            <div class="horario-row-mini">
                                <span><strong><%= t.dias.lunes %>:</strong></span>
                                <span><%= contactInfo.horario.lunes %></span>
                            </div>
                            <div class="horario-row-mini">
                                <span><strong><%= t.dias.martes %>:</strong></span>
                                <span><%= contactInfo.horario.martes %></span>
                            </div>
                            <div class="horario-row-mini">
                                <span><strong><%= t.dias.miercoles %>:</strong></span>
                                <span><%= contactInfo.horario.miercoles %></span>
                            </div>
                            <div class="horario-row-mini">
                                <span><strong><%= t.dias.jueves %>:</strong></span>
                                <span><%= contactInfo.horario.jueves %></span>
                            </div>
                            <div class="horario-row-mini">
                                <span><strong><%= t.dias.viernes %>:</strong></span>
                                <span><%= contactInfo.horario.viernes %></span>
                            </div>
                            <div class="horario-row-mini">
                                <span><strong><%= t.dias.sabado %>:</strong></span>
                                <span><%= contactInfo.horario.sabado %></span>
                            </div>
                            <div class="horario-row-mini horario-cerrado">
                                <span><strong><%= t.dias.domingo %>:</strong></span>
                                <span><%= contactInfo.horario.domingo %></span>
                            </div>
                        </div>
                    </div>

                    <div class="info-item">
                        <h3><%= t.contacto.redes_section %></h3>
                        <p>
                            <a href="https://instagram.com/cuidanimals.esp" target="_blank"><img src="/images/Instagram_icon.png" alt="Instagram" class="social-icon"> Instagram</a> |
                            <a href="https://facebook.com/cuidanimals" target="_blank"><img src="/images/facebook_logo_icon_257007.webp" alt="Facebook" class="social-icon"> Facebook</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Horario -->
    <section class="horario-section" style="position: relative;">
        <div class="container">
            <h2><%= t.index.horario_title %></h2>
            <div class="horario-table">
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.lunes %></span>
                    <span class="horario-horas"><%= contactInfo.horario.lunes %></span>
                </div>
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.martes %></span>
                    <span class="horario-horas"><%= contactInfo.horario.martes %></span>
                </div>
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.miercoles %></span>
                    <span class="horario-horas"><%= contactInfo.horario.miercoles %></span>
                </div>
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.jueves %></span>
                    <span class="horario-horas"><%= contactInfo.horario.jueves %></span>
                </div>
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.viernes %></span>
                    <span class="horario-horas"><%= contactInfo.horario.viernes %></span>
                </div>
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.sabado %></span>
                    <span class="horario-horas"><%= contactInfo.horario.sabado %></span>
                </div>
                <div class="horario-row horario-cerrado">
                    <span class="horario-dia"><%= t.dias.domingo %></span>
                    <span class="horario-horas"><%= contactInfo.horario.domingo %></span>
                </div>
            </div>
        </div>
    </section>

    <!-- Mapa -->
    <section class="map-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-cat" style="top: 10%; left: 8%;">🐾</div>
            <div class="paw-print paw-dog" style="top: 15%; right: 10%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 15%; right: 12%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 10%; left: 10%;">🐾</div>
        </div>
        <div class="container">
            <h2><%= t.contacto.mapa_title %></h2>
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3118.3984568074926!2d-0.3987!3d38.7626!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd623f8b0f8b0f8b%3A0x1234567890123456!2sCarrer%20Sant%20Jaume%2C%2025%2C%2003780%20Pego%2C%20Alicante!5e0!3m2!1ses!2ses!4v1234567890123" width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p><%= t.footer.rights %></p>
            <div class="social-links">
                <a href="https://instagram.com/cuidanimals.esp" target="_blank"><img src="/images/Instagram_icon.png" alt="Instagram" class="social-icon"> Instagram</a>
                <a href="https://facebook.com/cuidanimals" target="_blank"><img src="/images/facebook_logo_icon_257007.webp" alt="Facebook" class="social-icon"> Facebook</a>
                <a href="https://tiktok.com/@cuidanimals" target="_blank" class="tiktok-link">
                    <svg class="social-icon tiktok-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
                        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9.12a8.16 8.16 0 0 0 4.77 1.52V7.19a4.85 4.85 0 0 1-1-.5z"/>
                    </svg>
                    TikTok
                </a>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/34622358009?text=<%= t.whatsapp.message %>" target="_blank" class="whatsapp-button" title="<%= t.whatsapp.title %>">
        <img src="/images/whatsapp-logo.webp" alt="WhatsApp" class="whatsapp-logo-img">
    </a>

    <script src="/script.js"></script>
    <script>
        var errorMsg = '<%= t.contacto.error_msg %>';

        document.getElementById('contactForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const formData = {
                nombre: document.getElementById('nombre').value,
                email: document.getElementById('email').value,
                telefono: document.getElementById('telefono').value,
                mensaje: document.getElementById('mensaje').value
            };

            try {
                const response = await fetch('/api/contacto', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (data.success) {
                    document.getElementById('formMessage').textContent = '✅ ' + data.mensaje;
                    document.getElementById('formMessage').classList.add('success');
                    document.getElementById('formMessage').style.display = 'block';
                    document.getElementById('contactForm').reset();
                }
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('formMessage').textContent = '❌ ' + errorMsg;
                document.getElementById('formMessage').classList.add('error');
                document.getElementById('formMessage').style.display = 'block';
            }
        });
    </script>
</body>
</html>
