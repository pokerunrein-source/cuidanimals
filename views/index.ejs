<%
  const pageTitle = t.index.title;
  const pageDescription = 'Cuidado profesional y amoroso para tu mascota. Guardería de mascotas, paseos de perros y visitas a domicilio en Pego, Alicante.';
  const pageUrl = '/';
%>
<%- include('header', { pageTitle, pageDescription, pageUrl, t }) %>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo-brand">
                <span class="logo-icon">🐾</span>
                <span class="logo-text">CuidAnimals</span>
            </div>
            <ul class="nav-links">
                <li><a href="/" class="active"><%= t.nav.inicio %></a></li>
                <li><a href="/servicios"><%= t.nav.servicios %></a></li>
                <li><a href="/sobre-nosotros"><%= t.nav.sobre_nosotros %></a></li>
                <li><a href="/galeria"><%= t.nav.galeria %></a></li>
                <li><a href="/citas"><%= t.nav.citas %></a></li>
                <li><a href="/contacto"><%= t.nav.contacto %></a></li>
            </ul>
            <div class="lang-switcher">
                <a href="/set-lang/es" class="lang-btn <%= t.lang === 'es' ? 'active' : '' %>">ES</a>
                <a href="/set-lang/en" class="lang-btn <%= t.lang === 'en' ? 'active' : '' %>">EN</a>
                <a href="/set-lang/fr" class="lang-btn <%= t.lang === 'fr' ? 'active' : '' %>">FR</a>
                <a href="/set-lang/de" class="lang-btn <%= t.lang === 'de' ? 'active' : '' %>">DE</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-dog" style="top: 10%; left: 5%;">🐾</div>
            <div class="paw-print paw-cat" style="top: 20%; right: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 20%; left: 15%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 10%; right: 5%;">🐾</div>
        </div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="hero-logo-brand">
                <span class="hero-logo-icon">🐾</span>
                <span class="hero-logo-text">CuidAnimals</span>
            </div>
            <h1><%= t.index.hero_title %></h1>
            <p class="hero-slogan"><%= t.index.hero_subtitle %></p>
            <a href="/citas" class="btn btn-primary"><%= t.index.hero_btn %></a>
        </div>
    </section>

    <!-- Estadísticas -->
    <section class="estadisticas-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-cat" style="top: 15%; left: 8%;">🐾</div>
            <div class="paw-print paw-dog" style="top: 25%; right: 12%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 15%; right: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 5%; left: 5%;">🐾</div>
        </div>
        <div class="container">
            <div class="estadisticas-grid">
                <% estadisticas.forEach(stat => { %>
                    <div class="stat-card">
                        <div class="stat-number"><%= stat.numero %></div>
                        <div class="stat-label"><%= stat.label %></div>
                        <% if (stat.descripcion) { %>
                            <div class="stat-description"><%= stat.descripcion %></div>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Servicios -->
    <section class="servicios-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-dog" style="top: 10%; left: 8%;">🐾</div>
            <div class="paw-print paw-cat" style="top: 30%; right: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 20%; right: 8%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 5%; left: 10%;">🐾</div>
        </div>
        <div class="container">
            <h2><%= t.index.servicios_title %></h2>
            <div class="servicios-grid">
                <% servicios.forEach(servicio => { %>
                    <div class="servicio-card">
                        <div class="servicio-icon"><%= servicio.icono %></div>
                        <h3><%= servicio.nombre %></h3>
                        <p><%= servicio.descripcion %></p>
                        <p class="precio"><strong><%= servicio.precio %></strong></p>
                        <a href="/citas" class="btn btn-secondary"><%= t.index.reservar_btn %></a>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Testimonios -->
    <section class="testimonios-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-cat" style="top: 5%; left: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="top: 20%; right: 15%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 15%; left: 12%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 10%; right: 8%;">🐾</div>
        </div>
        <div class="container">
            <h2><%= t.index.testimonios_title %></h2>
            <div class="testimonios-grid">
                <% testimonios.forEach(testimonial => { %>
                    <div class="testimonial-card">
                        <div class="stars">
                            <% for(let i = 0; i < testimonial.rating; i++) { %>
                                ⭐
                            <% } %>
                        </div>
                        <p>"<%= testimonial.texto %>"</p>
                        <p class="author">— <%= testimonial.nombre %></p>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-dog" style="top: 15%; left: 12%;">🐾</div>
            <div class="paw-print paw-cat" style="top: 10%; right: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 15%; right: 15%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 5%; left: 8%;">🐾</div>
        </div>
        <div class="container">
            <h2><%= t.index.cta_title %></h2>
            <p><%= t.index.cta_subtitle %></p>
            <a href="/contacto" class="btn btn-primary"><%= t.index.cta_btn %></a>
        </div>
    </section>

    <!-- Horario -->
    <section class="horario-section" style="position: relative;">
        <div class="container">
            <h2><%= t.index.horario_title %></h2>
            <div class="horario-table">
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.lunes %></span>
                    <span class="horario-horas"><%= contactInfo.horario.lunes %></span>
                </div>
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.martes %></span>
                    <span class="horario-horas"><%= contactInfo.horario.martes %></span>
                </div>
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.miercoles %></span>
                    <span class="horario-horas"><%= contactInfo.horario.miercoles %></span>
                </div>
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.jueves %></span>
                    <span class="horario-horas"><%= contactInfo.horario.jueves %></span>
                </div>
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.viernes %></span>
                    <span class="horario-horas"><%= contactInfo.horario.viernes %></span>
                </div>
                <div class="horario-row">
                    <span class="horario-dia"><%= t.dias.sabado %></span>
                    <span class="horario-horas"><%= contactInfo.horario.sabado %></span>
                </div>
                <div class="horario-row horario-cerrado">
                    <span class="horario-dia"><%= t.dias.domingo %></span>
                    <span class="horario-horas"><%= contactInfo.horario.domingo %></span>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p><%= t.footer.rights %></p>
            <div class="social-links">
                <a href="https://instagram.com/cuidanimals.esp" target="_blank"><img src="/images/Instagram_icon.png" alt="Instagram" class="social-icon"> Instagram</a>
                <a href="https://facebook.com/cuidanimals" target="_blank"><img src="/images/facebook_logo_icon_257007.webp" alt="Facebook" class="social-icon"> Facebook</a>
                <a href="https://tiktok.com/@cuidanimals" target="_blank" class="tiktok-link">
                    <svg class="social-icon tiktok-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
                        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9.12a8.16 8.16 0 0 0 4.77 1.52V7.19a4.85 4.85 0 0 1-1-.5z"/>
                    </svg>
                    TikTok
                </a>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/34622358009?text=<%= t.whatsapp.message %>" target="_blank" class="whatsapp-button" title="<%= t.whatsapp.title %>">
        <img src="/images/whatsapp-logo.webp" alt="WhatsApp" class="whatsapp-logo-img">
    </a>

    <script src="/script.js"></script>
</body>
</html>
