<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CuidAnimals - Cuidado Profesional de Mascotas</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo-brand">
                <span class="logo-icon">🐾</span>
                <span class="logo-text">CuidAnimals</span>
            </div>
            <ul class="nav-links">
                <li><a href="/" class="active">Inicio</a></li>
                <li><a href="/servicios">Servicios</a></li>
                <li><a href="/sobre-nosotros">Sobre Nosotros</a></li>
                <li><a href="/galeria">Galería</a></li>
                <li><a href="/citas">Citas</a></li>
                <li><a href="/contacto">Contacto</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero" id="hero">
        <div class="hero-bg-parallax" id="heroBgParallax"></div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1>Bienvenido a CuidAnimals</h1>
            <p>Cuidado profesional y amoroso para tu mascota</p>
            <a href="/citas" class="btn btn-primary">Reservar Cita</a>
        </div>
    </section>

    <!-- Servicios -->
    <section class="servicios-section">
        <div class="container">
            <h2>Nuestros Servicios</h2>
            <div class="servicios-grid">
                <% servicios.forEach(servicio => { %>
                    <div class="servicio-card">
                        <div class="servicio-icon"><%= servicio.icono %></div>
                        <h3><%= servicio.nombre %></h3>
                        <p><%= servicio.descripcion %></p>
                        <p class="precio"><strong><%= servicio.precio %></strong></p>
                        <a href="/citas" class="btn btn-secondary">Reservar</a>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Testimonios -->
    <section class="testimonios-section">
        <div class="container">
            <h2>Lo que dicen nuestros clientes</h2>
            <div class="testimonios-grid">
                <% testimonios.forEach(testimonial => { %>
                    <div class="testimonial-card">
                        <div class="stars">
                            <% for(let i = 0; i < testimonial.rating; i++) { %>
                                ⭐
                            <% } %>
                        </div>
                        <p>"<%= testimonial.texto %>"</p>
                        <p class="author">— <%= testimonial.nombre %></p>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
        <div class="container">
            <h2>¿Listo para cuidar a tu mascota?</h2>
            <p>Contáctanos hoy y reserva tu primera cita</p>
            <a href="/contacto" class="btn btn-primary">Contactar</a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 CuidAnimals. Todos los derechos reservados.</p>
            <div class="social-links">
                <a href="https://instagram.com/cuidanimals.esp" target="_blank">Instagram</a>
                <a href="https://facebook.com/cuidanimals" target="_blank">Facebook</a>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/34622358009?text=Hola%20CuidAnimals%20quiero%20saber%20más%20sobre%20vuestros%20servicios" target="_blank" class="whatsapp-button" title="Contactar por WhatsApp">
        <img src="/images/whatsapp-logo.webp" alt="WhatsApp" class="whatsapp-logo-img">
    </a>

    <script src="/script.js"></script>
</body>
</html>
