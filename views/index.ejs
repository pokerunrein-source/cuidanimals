<!DOCTYPE html>
<html lang="<%= t.lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.index.title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Formas Geométricas Flotantes -->
    <div class="floating-shapes">
        <div class="shape shape-circle" style="top: 10%; left: 5%;"></div>
        <div class="shape shape-square" style="top: 20%; right: 10%;"></div>
        <div class="shape shape-circle" style="bottom: 20%; left: 15%;"></div>
        <div class="shape shape-triangle" style="bottom: 10%; right: 5%;"></div>
        <div class="shape shape-square" style="top: 50%; right: 2%;"></div>
    </div>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo-brand">
                <span class="logo-icon">🐾</span>
                <span class="logo-text">CuidAnimals</span>
            </div>
            <ul class="nav-links">
                <li><a href="/" class="active"><%= t.nav.inicio %></a></li>
                <li><a href="/servicios"><%= t.nav.servicios %></a></li>
                <li><a href="/sobre-nosotros"><%= t.nav.sobre_nosotros %></a></li>
                <li><a href="/galeria"><%= t.nav.galeria %></a></li>
                <li><a href="/citas"><%= t.nav.citas %></a></li>
                <li><a href="/contacto"><%= t.nav.contacto %></a></li>
            </ul>
            <div class="lang-switcher">
                <a href="/set-lang/es" class="lang-btn <%= t.lang === 'es' ? 'active' : '' %>">🇪🇸 ES</a>
                <a href="/set-lang/en" class="lang-btn <%= t.lang === 'en' ? 'active' : '' %>">🇬🇧 EN</a>
                <a href="/set-lang/fr" class="lang-btn <%= t.lang === 'fr' ? 'active' : '' %>">🇫🇷 FR</a>
                <a href="/set-lang/de" class="lang-btn <%= t.lang === 'de' ? 'active' : '' %>">🇩🇪 DE</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1><%= t.index.hero_title %></h1>
            <p><%= t.index.hero_subtitle %></p>
            <a href="/citas" class="btn btn-primary"><%= t.index.hero_btn %></a>
        </div>
    </section>

    <!-- Estadísticas -->
    <section class="estadisticas-section">
        <div class="container">
            <div class="estadisticas-grid">
                <div class="stat-card">
                    <div class="stat-number">+500</div>
                    <div class="stat-label">Mascotas Cuidadas</div>
                    <div class="stat-description">Hemos cuidado miles de mascotas</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">5+</div>
                    <div class="stat-label">Años de Experiencia</div>
                    <div class="stat-description">Más de 5 años sirviendo</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">4.9</div>
                    <div class="stat-label">Calificación</div>
                    <div class="stat-description">Puntuación en Google</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">24/7</div>
                    <div class="stat-label">Disponibilidad</div>
                    <div class="stat-description">Siempre a tu servicio</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Servicios -->
    <section class="servicios-section">
        <div class="container">
            <h2><%= t.index.servicios_title %></h2>
            <div class="servicios-grid">
                <% servicios.forEach(servicio => { %>
                    <div class="servicio-card">
                        <div class="servicio-icon"><%= servicio.icono %></div>
                        <h3><%= servicio.nombre %></h3>
                        <p><%= servicio.descripcion %></p>
                        <p class="precio"><strong><%= servicio.precio %></strong></p>
                        <a href="/citas" class="btn btn-secondary"><%= t.index.reservar_btn %></a>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Testimonios -->
    <section class="testimonios-section">
        <div class="container">
            <h2><%= t.index.testimonios_title %></h2>
            <div class="testimonios-grid">
                <% testimonios.forEach(testimonial => { %>
                    <div class="testimonial-card">
                        <div class="stars">
                            <% for(let i = 0; i < testimonial.rating; i++) { %>
                                ⭐
                            <% } %>
                        </div>
                        <p>"<%= testimonial.texto %>"</p>
                        <p class="author">— <%= testimonial.nombre %></p>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
        <div class="container">
            <h2><%= t.index.cta_title %></h2>
            <p><%= t.index.cta_subtitle %></p>
            <a href="/contacto" class="btn btn-primary"><%= t.index.cta_btn %></a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p><%= t.footer.rights %></p>
            <div class="social-links">
                <a href="https://instagram.com/cuidanimals.esp" target="_blank">Instagram</a>
                <a href="https://facebook.com/cuidanimals" target="_blank">Facebook</a>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/34622358009?text=<%= t.whatsapp.message %>" target="_blank" class="whatsapp-button" title="<%= t.whatsapp.title %>">
        <img src="/images/whatsapp-logo.webp" alt="WhatsApp" class="whatsapp-logo-img">
    </a>

    <script src="/script.js"></script>
</body>
</html>
