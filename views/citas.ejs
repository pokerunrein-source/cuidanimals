<!DOCTYPE html>
<html lang="<%= t.lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.citas.title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo-brand">
                <span class="logo-icon">🐾</span>
                <span class="logo-text">CuidAnimals</span>
            </div>
            <ul class="nav-links">
                <li><a href="/"><%= t.nav.inicio %></a></li>
                <li><a href="/servicios"><%= t.nav.servicios %></a></li>
                <li><a href="/sobre-nosotros"><%= t.nav.sobre_nosotros %></a></li>
                <li><a href="/galeria"><%= t.nav.galeria %></a></li>
                <li><a href="/citas" class="active"><%= t.nav.citas %></a></li>
                <li><a href="/contacto"><%= t.nav.contacto %></a></li>
            </ul>
            <div class="lang-switcher">
                <a href="/set-lang/es" class="lang-btn <%= t.lang === 'es' ? 'active' : '' %>">🇪🇸 ES</a>
                <a href="/set-lang/en" class="lang-btn <%= t.lang === 'en' ? 'active' : '' %>">🇬🇧 EN</a>
                <a href="/set-lang/fr" class="lang-btn <%= t.lang === 'fr' ? 'active' : '' %>">🇫🇷 FR</a>
                <a href="/set-lang/de" class="lang-btn <%= t.lang === 'de' ? 'active' : '' %>">🇩🇪 DE</a>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1><%= t.citas.page_title %></h1>
            <p><%= t.citas.page_subtitle %></p>
        </div>
    </section>

    <!-- Formulario de Citas -->
    <section class="citas-section">
        <div class="container">
            <div class="citas-form-wrapper">
                <h2><%= t.citas.form_title %></h2>
                <form id="citasForm" class="citas-form">
                    <div class="form-group">
                        <label for="nombre"><%= t.citas.nombre_label %></label>
                        <input type="text" id="nombre" name="nombre" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="email"><%= t.citas.email_label %></label>
                            <input type="email" id="email" name="email" required>
                        </div>
                        <div class="form-group">
                            <label for="telefono"><%= t.citas.telefono_label %></label>
                            <input type="tel" id="telefono" name="telefono" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="mascota"><%= t.citas.mascota_label %></label>
                        <input type="text" id="mascota" name="mascota" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="servicio"><%= t.citas.servicio_label %></label>
                            <select id="servicio" name="servicio" required>
                                <option value=""><%= t.citas.servicio_placeholder %></option>
                                <% servicios.forEach(servicio => { %>
                                    <option value="<%= servicio.nombre %>"><%= servicio.nombre %> - <%= servicio.precio %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="fecha"><%= t.citas.fecha_label %></label>
                            <input type="date" id="fecha" name="fecha" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="hora"><%= t.citas.hora_label %></label>
                        <select id="hora" name="hora" required>
                            <option value=""><%= t.citas.hora_placeholder %></option>
                            <option value="09:00">09:00 AM</option>
                            <option value="10:00">10:00 AM</option>
                            <option value="11:00">11:00 AM</option>
                            <option value="12:00">12:00 PM</option>
                            <option value="13:00">01:00 PM</option>
                            <option value="14:00">02:00 PM</option>
                            <option value="15:00">03:00 PM</option>
                            <option value="16:00">04:00 PM</option>
                            <option value="17:00">05:00 PM</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="mensaje"><%= t.citas.observaciones_label %></label>
                        <textarea id="mensaje" name="mensaje" rows="4" placeholder="<%= t.citas.observaciones_placeholder %>"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-large"><%= t.citas.submit_btn %></button>
                    <div id="formMessage" class="form-message" style="display: none;"></div>
                </form>
            </div>
        </div>
    </section>

    <!-- Información adicional -->
    <section class="citas-info">
        <div class="container">
            <h2><%= t.citas.info_title %></h2>
            <div class="info-grid">
                <div class="info-card">
                    <h3><%= t.citas.info1_title %></h3>
                    <p><%= t.citas.info1_desc %></p>
                </div>
                <div class="info-card">
                    <h3><%= t.citas.info2_title %></h3>
                    <p><%= t.citas.info2_desc %></p>
                </div>
                <div class="info-card">
                    <h3><%= t.citas.info3_title %></h3>
                    <p><%= t.citas.info3_desc %></p>
                </div>
                <div class="info-card">
                    <h3><%= t.citas.info4_title %></h3>
                    <p><%= t.citas.info4_desc %></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p><%= t.footer.rights %></p>
            <div class="social-links">
                <a href="https://instagram.com/cuidanimals.esp" target="_blank">Instagram</a>
                <a href="https://facebook.com/cuidanimals" target="_blank">Facebook</a>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/34622358009?text=<%= t.whatsapp.message %>" target="_blank" class="whatsapp-button" title="<%= t.whatsapp.title %>">
        <img src="/images/whatsapp-logo.webp" alt="WhatsApp" class="whatsapp-logo-img">
    </a>

    <script src="/script.js"></script>
    <script>
        var errorMsg = '<%= t.citas.error_msg %>';

        document.getElementById('citasForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const formData = {
                nombre: document.getElementById('nombre').value,
                email: document.getElementById('email').value,
                telefono: document.getElementById('telefono').value,
                mascota: document.getElementById('mascota').value,
                servicio: document.getElementById('servicio').value,
                fecha: document.getElementById('fecha').value,
                hora: document.getElementById('hora').value
            };

            try {
                const response = await fetch('/api/cita', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (data.success) {
                    document.getElementById('formMessage').textContent = '✅ ' + data.mensaje;
                    document.getElementById('formMessage').classList.add('success');
                    document.getElementById('formMessage').style.display = 'block';
                    document.getElementById('citasForm').reset();
                }
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('formMessage').textContent = '❌ ' + errorMsg;
                document.getElementById('formMessage').classList.add('error');
                document.getElementById('formMessage').style.display = 'block';
            }
        });

        // Establecer fecha mínima a hoy
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('fecha').setAttribute('min', today);
    </script>
</body>
</html>
