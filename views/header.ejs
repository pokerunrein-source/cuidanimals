<!DOCTYPE html>
<html lang="<%= t.lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- SEO Meta Tags -->
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= pageDescription %>">
    <meta name="keywords" content="cuidado de mascotas, guardería de perros, guardería de gatos, paseos de perros, Pego, Alicante">
    <meta name="author" content="CuidAnimals">
    <meta name="robots" content="index, follow">
    <meta name="language" content="<%= t.lang %>">

    <!-- Open Graph Tags -->
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <meta property="og:image" content="https://cuidanimals.vercel.app/images/foto2.jpg">
    <meta property="og:url" content="https://cuidanimals.vercel.app<%= pageUrl %>">
    <meta property="og:type" content="website">

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= pageDescription %>">
    <meta name="twitter:image" content="https://cuidanimals.vercel.app/images/foto2.jpg">

    <!-- Canonical URL -->
    <link rel="canonical" href="https://cuidanimals.vercel.app<%= pageUrl %>">

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "CuidAnimals",
      "description": "Cuidado profesional y amoroso para tu mascota",
      "url": "https://cuidanimals.vercel.app",
      "telephone": "+34622358009",
      "email": "info@cuidanimals.es",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Carrer Sant Jaume, 25",
        "addressLocality": "Pego",
        "addressRegion": "Alicante",
        "postalCode": "03780",
        "addressCountry": "ES"
      },
      "image": "https://cuidanimals.vercel.app/images/foto2.jpg",
      "priceRange": "€10-€100",
      "ratingValue": "4.9",
      "ratingCount": "5000",
      "areaServed": {
        "@type": "City",
        "name": "Pego, Alicante"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "19:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "10:00",
          "closes": "16:00"
        }
      ],
      "sameAs": [
        "https://instagram.com/cuidanimals.esp",
        "https://facebook.com/cuidanimals"
      ]
    }
    </script>

    <link rel="stylesheet" href="/styles.css">
</head>
<body>
