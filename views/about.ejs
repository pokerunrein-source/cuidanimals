<%
  const pageTitle = t.about.title;
  const pageDescription = 'Conoce la historia de CuidAnimals, nuestro equipo profesional y nuestro compromiso con el cuidado amoroso de mascotas en Pego, Alicante.';
  const pageUrl = '/sobre-nosotros';
%>
<%- include('header', { pageTitle, pageDescription, pageUrl, t }) %>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo-brand">
                <span class="logo-icon">🐾</span>
                <span class="logo-text">CuidAnimals</span>
            </div>
            <ul class="nav-links">
                <li><a href="/"><%= t.nav.inicio %></a></li>
                <li><a href="/servicios"><%= t.nav.servicios %></a></li>
                <li><a href="/sobre-nosotros" class="active"><%= t.nav.sobre_nosotros %></a></li>
                <li><a href="/galeria"><%= t.nav.galeria %></a></li>
                <li><a href="/citas"><%= t.nav.citas %></a></li>
                <li><a href="/contacto"><%= t.nav.contacto %></a></li>
            </ul>
            <div class="lang-switcher">
                <a href="/set-lang/es" class="lang-btn <%= t.lang === 'es' ? 'active' : '' %>">ES</a>
                <a href="/set-lang/en" class="lang-btn <%= t.lang === 'en' ? 'active' : '' %>">EN</a>
                <a href="/set-lang/fr" class="lang-btn <%= t.lang === 'fr' ? 'active' : '' %>">FR</a>
                <a href="/set-lang/de" class="lang-btn <%= t.lang === 'de' ? 'active' : '' %>">DE</a>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1><%= t.about.page_title %></h1>
            <p><%= t.about.page_subtitle %></p>
        </div>
    </section>

    <!-- Nuestra Historia -->
    <section class="about-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-dog" style="top: 10%; left: 8%;">🐾</div>
            <div class="paw-print paw-cat" style="top: 25%; right: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 20%; right: 12%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 10%; left: 8%;">🐾</div>
        </div>
        <div class="container">
            <h2><%= t.about.historia_title %></h2>
            <div class="about-wrapper">
                <div class="about-content">
                    <p><%= t.about.historia_p1 %></p>
                    <p><%= t.about.historia_p2 %></p>
                    <p><%= t.about.historia_p3 %></p>
                </div>
                <div class="about-image">
                    <img src="/images/foto1.jpg" alt="<%= t.about.img_alt %>" class="about-photo">
                </div>
            </div>
        </div>
    </section>

    <!-- Valores -->
    <section class="values-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-cat" style="top: 10%; left: 10%;">🐾</div>
            <div class="paw-print paw-dog" style="top: 20%; right: 12%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 18%; left: 12%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 8%; right: 10%;">🐾</div>
        </div>
        <div class="container">
            <h2><%= t.about.valores_title %></h2>
            <div class="values-grid">
                <div class="value-card">
                    <h3><%= t.about.valor1_title %></h3>
                    <p><%= t.about.valor1_desc %></p>
                </div>
                <div class="value-card">
                    <h3><%= t.about.valor2_title %></h3>
                    <p><%= t.about.valor2_desc %></p>
                </div>
                <div class="value-card">
                    <h3><%= t.about.valor3_title %></h3>
                    <p><%= t.about.valor3_desc %></p>
                </div>
                <div class="value-card">
                    <h3><%= t.about.valor4_title %></h3>
                    <p><%= t.about.valor4_desc %></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Información de Contacto -->
    <section class="contact-info-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-dog" style="top: 10%; left: 10%;">🐾</div>
            <div class="paw-print paw-cat" style="top: 15%; right: 12%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 20%; right: 10%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 10%; left: 8%;">🐾</div>
        </div>
        <div class="container">
            <h2><%= t.about.contacto_title %></h2>
            <div class="contact-info-grid">
                <div class="contact-card">
                    <h3><%= t.about.ubicacion_label %></h3>
                    <p><%= contactInfo.direccion %></p>
                </div>
                <div class="contact-card">
                    <h3><%= t.about.telefono_label %></h3>
                    <p><a href="tel:<%= contactInfo.telefono %>"><%= contactInfo.telefono %></a></p>
                </div>
                <div class="contact-card">
                    <h3><%= t.about.horario_label %></h3>
                    <p><strong><%= t.about.lunes_viernes %>:</strong> <%= contactInfo.horario.lunes_viernes %></p>
                    <p><strong><%= t.about.sabados %>:</strong> <%= contactInfo.horario.sabados %></p>
                    <p><strong><%= t.about.domingos %>:</strong> <%= contactInfo.horario.domingos %></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Mapa -->
    <section class="map-section" style="position: relative;">
        <div class="paw-prints">
            <div class="paw-print paw-cat" style="top: 10%; left: 8%;">🐾</div>
            <div class="paw-print paw-dog" style="top: 15%; right: 10%;">🐾</div>
            <div class="paw-print paw-cat" style="bottom: 20%; right: 12%;">🐾</div>
            <div class="paw-print paw-dog" style="bottom: 10%; left: 10%;">🐾</div>
        </div>
        <div class="container">
            <h2><%= t.about.visitanos %></h2>
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3118.3984568074926!2d-0.3987!3d38.7626!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd623f8b0f8b0f8b%3A0x1234567890123456!2sCarrer%20Sant%20Jaume%2C%2025%2C%2003780%20Pego%2C%20Alicante!5e0!3m2!1ses!2ses!4v1234567890123" width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p><%= t.footer.rights %></p>
            <div class="social-links">
                <a href="https://instagram.com/cuidanimals.esp" target="_blank"><img src="/images/Instagram_icon.png" alt="Instagram" class="social-icon"> Instagram</a>
                <a href="https://facebook.com/cuidanimals" target="_blank"><img src="/images/facebook_logo_icon_257007.webp" alt="Facebook" class="social-icon"> Facebook</a>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/34622358009?text=<%= t.whatsapp.message %>" target="_blank" class="whatsapp-button" title="<%= t.whatsapp.title %>">
        <img src="/images/whatsapp-logo.webp" alt="WhatsApp" class="whatsapp-logo-img">
    </a>

    <script src="/script.js"></script>
</body>
</html>
